AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=your-api-audience
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/smart_mirror
# Shared secret between the server and each mirror. Set this on the server and
# export MIRROR_API_KEY=<same value> on the Raspberry Pi before starting face_recognize.py.
MIRROR_API_KEY=change-me-to-a-random-secret

# Optional: Token required to post admin banners via /api/admin/banner
ADMIN_TOKEN=your-admin-token

# Optional: Discord webhook URL to receive notifications when the Windows server updates and restarts
DISCORD_WEBHOOK_URL=
