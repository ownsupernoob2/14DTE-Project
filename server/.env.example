# ── Auth0 (sign-in for the website) ──────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/

# Optional: a machine-to-machine Auth0 app with the delete:users scope. When
# set, deleting a user in the admin dashboard also removes their Auth0 login.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Admin dashboard access: comma-separated, verified Auth0 emails.
ADMIN_EMAILS=marminamina3@gmail.com

PORT=8080

# Shared secret between the server and every mirror. Set the same value as
# MIRROR_API_KEY in each Raspberry Pi's ~/.config/smart-mirror/env. While it is
# unset, the face index and mirror endpoints are open to anyone.
MIRROR_API_KEY=

# Token run-and-update.ps1 uses to post "server updating" banners.
ADMIN_TOKEN=

# Optional: restrict which websites may call the API (comma-separated origins).
CORS_ORIGINS=

# Optional: Discord webhook for update notifications from run-and-update.ps1.
DISCORD_WEBHOOK_URL=

# Optional: full path to a Python with face_recognition, if not in server\.venv.
PYTHON_CMD=
